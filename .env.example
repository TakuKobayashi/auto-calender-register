# Yahoo! JAPAN ID（公式設定に従い、通常はメールアドレスの @ より前）
YAHOO_IMAP_USER=
YAHOO_IMAP_PASSWORD=
YAHOO_IMAP_HOST=imap.mail.yahoo.co.jp
YAHOO_IMAP_PORT=993
YAHOO_IMAP_MAILBOX=INBOX

# 登録先は --calendar-id で指定（省略時は認証したユーザーのメインカレンダー）
# ローカルは auth login で .secrets/google-oauth.json に保存します。
# CIでは同じJSONをGitHub Secret GOOGLE_OAUTH_JSONとして環境変数に渡します。
# GOOGLE_OAUTH_JSON={"version":1,"client_id":"...","client_secret":"...","refresh_token":"..."}
# 代わりに次の3変数でも渡せます（JSON環境変数が最優先）。
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
