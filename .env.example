# Yahoo! JAPAN ID（公式設定に従い、通常はメールアドレスの @ より前）
YAHOO_IMAP_USER=
YAHOO_IMAP_PASSWORD=
YAHOO_IMAP_HOST=imap.mail.yahoo.co.jp
YAHOO_IMAP_PORT=993
YAHOO_IMAP_MAILBOX=INBOX

# 登録先は --calendar-id で指定（省略時は認証したユーザーのメインカレンダー）
# 初回認証: デスクトップアプリ用OAuthクライアントのID・シークレットを設定します。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# npm run auth:login でブラウザー認証し、トークンを .secrets/google-oauth.json に保存します。
# GOOGLE_REFRESH_TOKENは初回認証では不要です。空なら保存済みファイルを利用します。
# CIでは同じJSONをGitHub Secret GOOGLE_OAUTH_JSONとして環境変数に渡します。
# GOOGLE_OAUTH_JSON={"version":1,"client_id":"...","client_secret":"...","refresh_token":"..."}
# CI等では保存済みファイルの代わりに3変数でも渡せます（JSON環境変数が最優先）。
# GOOGLE_REFRESH_TOKEN=
