{
  "name": "auto-calender-register",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "task": "task",
    "task:list": "task --list",
    "mail:check": "tsx src/cli.ts check",
    "mail:list": "tsx src/cli.ts list",
    "mail:show": "tsx src/cli.ts show",
    "mail:inspect": "tsx src/cli.ts inspect",
    "calendar:dry-run": "tsx src/cli.ts dry-run",
    "calendar:audit-forwards": "tsx src/cli.ts audit-forwards",
    "auth:login": "tsx src/cli.ts auth login",
    "auth:status": "tsx src/cli.ts auth status",
    "auth:export": "tsx src/cli.ts auth export",
    "calendar:plan": "tsx src/cli.ts calendar sync",
    "calendar:register": "tsx src/cli.ts calendar sync --apply",
    "calendar:ics": "tsx src/cli.ts calendar export-ics",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "chrono-node": "^2.10.3",
    "commander": "^15.1.0",
    "dotenv": "^18.0.10",
    "google-auth-library": "^11.3.4",
    "html-to-text": "^10.0.1",
    "imapflow": "^2.12.1",
    "luxon": "^3.7.2",
    "mailparser": "^3.14.4",
    "node-ical": "^0.27.6",
    "open": "^11.0.4"
  },
  "devDependencies": {
    "@go-task/cli": "3.45.4",
    "@types/html-to-text": "^9.0.4",
    "@types/luxon": "^3.7.6",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.6",
    "prettier": "3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
